# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://x86xx.com

# ---- Data backend ----
# sqlite (default, local file via node:sqlite) | cloudflare (D1 + R2 via @opennextjs/cloudflare bindings)
DATA_BACKEND=sqlite
SQLITE_PATH=.data/x86xx.db
MEDIA_ROOT=.data/media

# ---- Generation safety switches (defaults are the safe ones) ----
# Master switch for calling real providers. Keep false until keys and budgets are set.
GENERATION_LIVE=false
# Jobs are dry runs (mock providers) unless explicitly requested live.
GENERATION_DRY_RUN=true
GENERATION_MAX_PER_RUN=5
GENERATION_MAX_LIVE_PER_DAY=10
GENERATION_MAX_ATTEMPTS=3
GENERATION_RETRY_BACKOFF_SECONDS=60
# A dispatcher must renew its lease on a running job within this many seconds; a lapsed lease means the worker died
GENERATION_LEASE_SECONDS=60

# Bearer token required by POST /api/jobs. Leave empty to disable that endpoint.
JOBS_API_TOKEN=

# ---- OpenRouter (text) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
# USD per 1M tokens, used only for cost estimates on job results
OPENROUTER_INPUT_PRICE_PER_M=0.03
OPENROUTER_OUTPUT_PRICE_PER_M=0.13

# ---- Pruna P-Video (video) ----
PRUNA_API_KEY=
PRUNA_MODEL=p-video
# 720p + draft=true is the cheap default. Pruna's own default is draft=false.
PRUNA_RESOLUTION=720p
PRUNA_DRAFT=true
PRUNA_DURATION_SECONDS=5
# USD per second of 720p video, for estimates
PRUNA_PRICE_PER_SECOND_DRAFT=0.005
PRUNA_PRICE_PER_SECOND_STANDARD=0.02

# ---- Operator login (the only login; visitors never need an account) ----
# Secret for signing the session cookie. openssl rand -base64 32
SESSION_SECRET=
# Password for /login → /dashboard. Leave empty to keep the dashboard closed.
OPERATOR_PASSWORD=
